# Code Assist is opt-in. Keep the API key in this backend environment only.
ASSISTANT_ENABLED=false
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_TIMEOUT_SECONDS=45

# Creative Director (/flow). DIRECTOR_PROVIDER=local talks to any OpenAI-compatible
# /v1/chat/completions server (llama-server, Ollama, LM Studio, vLLM).
DIRECTOR_ENABLED=false
DIRECTOR_PROVIDER=local
# MODEL: only used when DIRECTOR_PROVIDER=anthropic
DIRECTOR_MODEL=claude-opus-5-5
# LOCAL_LLM_URL=http://127.0.0.1:8080     # llama-server default is :8080, Ollama is :11434
# LOCAL_LLM_MODEL=qwen2.5-coder-3b-instruct
# LOCAL_LLM_TIMEOUT_SECONDS=120
# LOCAL_LLM_API_KEY=                     # only for a hosted endpoint

COMFY_HOST=127.0.0.1:8188
COMFY_TIMEOUT=1800  # seconds to wait for workflow execution (30 min default)
# Optional same-host ComfyUI directory. Enables Install to ComfyUI.
# Example: D:\\ComfyUI-master
COMFY_MODEL_ROOT=
# Max model file size in bytes (default: 200 GB = 214748364800)
# MODEL_MAX_BYTES=214748364800
STORAGE_DIR=generated
FILES_PUBLIC_BASE=http://localhost:8000
# Must match the browser URL exactly: scheme + host + port.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local Next.js dev ports 3000-3999 are allowed by default. Empty this in production.
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):3[0-9]{3}$

# =========================================================================
# Phase 2: Database (PostgreSQL Cloud or Local)
# =========================================================================
# Leave unset or empty to use local SQLite (solotensor.db).
# When set, Solo Studio automatically uses PostgreSQL (Supabase, Neon, AWS RDS, Docker).
# Example Supabase: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Example Neon:     postgresql://user:password@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_PATH=solotensor.db
AUTH_PROVIDER=local
JWT_SECRET=solotensor-jwt-secret-key-change-in-production

# =========================================================================
# Phase 2: Redis Job Queue & Cache
# =========================================================================
# Leave unset to use in-memory queue fallback.
# When set, generation tasks and caching use Redis (Upstash, AWS ElastiCache, Docker).
# Example Upstash: rediss://default:TOKEN@global-cool-token.upstash.io:6379
# Example Local:   redis://127.0.0.1:6379
REDIS_URL=

# =========================================================================
# Phase 2: Hybrid S3 / Cloudflare R2 Asset Storage
# =========================================================================
# Set S3_ENABLED=true or provide S3_BUCKET + S3_ACCESS_KEY_ID to upload generated assets to Cloudflare R2 / AWS S3.
# Local disk cache under STORAGE_DIR is automatically maintained.
S3_ENABLED=false
S3_BUCKET=
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: leave empty or provide endpoint
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Public CDN URL: e.g. https://pub-xxxx.r2.dev or https://assets.yourdomain.com
S3_PUBLIC_BASE_URL=

# Email & Verification (Resend or SMTP)
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Solo Studio <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
