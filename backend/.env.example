COMFY_HOST=127.0.0.1:8188
STORAGE_DIR=generated
FILES_PUBLIC_BASE=http://localhost:8000
# Must match the browser URL exactly: scheme + host + port.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local Next.js dev ports 3000-3999 are allowed by default. Empty this in production.
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):3[0-9]{3}$
# For LAN access, append the exact origin, e.g. http://192.168.1.50:3000.
